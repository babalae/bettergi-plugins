<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 插件标识与名称，写入 plugin.json -->
		<BgiPluginId>ppocr_v5_latin</BgiPluginId>
		<BgiPluginName>PaddleOCR V5 拉丁语系</BgiPluginName>
		<Version>1.0.0</Version>
		<Description>PP-OCRv5 检测与拉丁字母语言识别模型，适用于法语、德语、西班牙语、意大利语等。</Description>
	</PropertyGroup>

	<!-- 需要的模型目录，相对资源包的 Assets\Model\PaddleOCR -->
	<ItemGroup>
		<BgiPaddleOcrModel Include="Det\V5\PP-OCRv5_mobile_det_infer" />
		<BgiPaddleOcrModel Include="Rec\V5\latin_PP-OCRv5_mobile_rec_infer" />
	</ItemGroup>

</Project>
