<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 插件标识与名称，写入 plugin.json -->
		<BgiPluginId>ppocr_v4</BgiPluginId>
		<BgiPluginName>PaddleOCR V4 中文</BgiPluginName>
		<Version>1.0.0</Version>
		<Description>PP-OCRv4 检测与中文识别模型。</Description>
	</PropertyGroup>

	<!-- 需要的模型目录，相对资源包的 Assets\Model\PaddleOCR -->
	<ItemGroup>
		<BgiPaddleOcrModel Include="Det\V4\PP-OCRv4_mobile_det_infer" />
		<BgiPaddleOcrModel Include="Rec\V4\PP-OCRv4_mobile_rec_infer" />
	</ItemGroup>

</Project>
