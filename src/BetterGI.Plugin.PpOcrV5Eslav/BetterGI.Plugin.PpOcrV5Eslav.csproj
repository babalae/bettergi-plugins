<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 插件标识与名称，写入 plugin.json -->
		<BgiPluginId>ppocr_v5_eslav</BgiPluginId>
		<BgiPluginName>PaddleOCR V5 斯拉夫语系</BgiPluginName>
		<Version>1.0.0</Version>
		<Description>PP-OCRv5 检测与斯拉夫语言识别模型，适用于俄语、乌克兰语、白俄罗斯语。</Description>
	</PropertyGroup>

	<!-- 需要的模型目录，相对资源包的 Assets\Model\PaddleOCR -->
	<ItemGroup>
		<BgiPaddleOcrModel Include="Det\V5\PP-OCRv5_mobile_det_infer" />
		<BgiPaddleOcrModel Include="Rec\V5\eslav_PP-OCRv5_mobile_rec_infer" />
	</ItemGroup>

</Project>
